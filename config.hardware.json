{
  "camera_index": 0,
  "pose_model": "models/pose_landmarker_lite.task",
  "normalization": {
    "scale_mode": "hip_width",
    "visibility_threshold": 0.5,
    "min_scale": 0.02
  },
  "sensor": {
    "mode": "serial",
    "sample_rate_hz": 50,
    "pressure_channels": 4,
    "serial_port": "COM5",
    "baudrate": 115200,
    "environment_channels": 4
  },
  "step_detection": {
    "heel_channels": [
      0,
      1
    ],
    "refractory_ms": 450,
    "min_step_ms": 400,
    "max_step_ms": 2000
  },
  "live_gait_rom": {
    "scale_mode": "robust",
    "min_cycle_ms": 600,
    "max_cycle_ms": 2200,
    "direction_epsilon": 0.003,
    "smoothing_window": 5,
    "min_samples": 8
  },
  "rehab": {
    "side": "left",
    "target_knee_flexion_deg": 50.0,
    "rep_start_deg": 20.0,
    "rep_end_deg": 15.0,
    "trunk_delta_limit_deg": 10.0,
    "pelvic_tilt_delta_limit_deg": 8.0,
    "shoulder_tilt_delta_limit_deg": 8.0,
    "baseline_seconds": 3.0
  }
}
